:italic;\">undefined</span>'; } else { statusBadge = placeholders.has(vk) ? '<span style=\"color:#4ade80; font-size:0.75rem; margin-left:8px; padding:2px 6px; background:rgba(74,222,128,0.15); border-radius:4px; font-weight:600;\">Defined</span>' : '<span style=\"color:#facc15; font-size:0.75rem; margin-left:8px; padding:2px 6px; background:rgba(250,204,21,0.15); border-radius:4px; font-weight:600;\">Unused</span>'; valStr = typeof flatObj[vk] === 'string' ? flatObj[vk] : JSON.stringify(flatObj[vk]); } varsDisplay += `<tr style=\"border-bottom: 1px solid rgba(255,255,255,0.05); background: rgba(0,0,0,0.1);\"><td style=\"padding: 8px 12px; color: #10b981; vertical-align: top; width: 45%; border-right: 1px solid rgba(255,255,255,0.05);\">${vk} ${statusBadge}</td><td style=\"padding: 8px 12px; color: #cbd5e1; font-family: monospace;\">${valStr}</td></tr>`; } varsDisplay += '</tbody></table>'; } html += `<tr style=\"border-bottom: 1px solid rgba(255,255,255,0.05);\"><td style=\"padding: 10px 15px; color: #38bdf8; font-weight: 500; vertical-align: top; width: 30%; border-right: 1px solid rgba(255,255,255,0.05);\">${h}</td><td style=\"padding: 10px 15px; vertical-align: top;\">${varsDisplay}</td></tr>`; } html += `</tbody></table>`; } html += `</div>`; } } html += '<h3 style=\"color: #f8fafc; margin-top: 30px;\">Found Placeholders</h3>'; /* moved */ if (placeholders.size > 0) { placeholders.forEach(p => { html += `<div style=\"margin-bottom:10px; padding: 10px; background: rgba(0,0,0,0.2); border-radius: 6px; border-left: 3px solid #3b82f6;\"><span style=\"color:#cbd5e1; font-family: monospace;\">{{ ${p} }}</span></div>`; }); } else { html += '<p style=\"color: #94a3b8;\">No placeholders found in playbook.</p>'; } html += '</div>'; document.getElementById('logs-container').innerHTML = html; }); }); } function viewInventories() { document.getElementById('logs-container').innerHTML = '<p style=\"color:#64748b; text-align:center; margin-top:100px;\">Loading Inventories...</p>'; fetch('/api/info' + getInvQuery()).then(r => r.json()).then(data => { fetch('/api/playbook' + getInvQuery()).then(r => r.text()).then(content => { const regex = /\\{\\{([^}]+)\\}\\}/g; let match; const placeholders = new Set(); while ((match = regex.exec(content)) !== null) { placeholders.add(match[1].trim()); } let html = '<h2 style=\"margin-top:0; border:none; font-size:2rem; font-weight:800; color:transparent; background:linear-gradient(to right, #8b5cf6, #d946ef); -webkit-background-clip:text;\">Discovered Inventories</h2>'; html += '<div class=\"task-card\" style=\"padding: 25px;\">'; if (data.parsedInvs && Object.keys(data.parsedInvs).length > 0) { const flatten = (obj, prefix = \"\") => Object.keys(obj).reduce((acc, k) => { const pre = prefix.length ? prefix + \".\" : \"\"; if (typeof obj[k] === \"object\" && obj[k] !== null && !Array.isArray(obj[k])) Object.assign(acc, flatten(obj[k], pre + k)); else acc[pre + k] = obj[k]; return acc; }, {}); let globalFlatVars = data.vars ? flatten(data.vars) : {}; for(let filename in data.parsedInvs) { html += `<h3 style=\"color: #f8fafc; margin-top: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 5px;\">${filename}</h3>`; const inv = data.parsedInvs[filename]; if (inv && Object.keys(inv).length > 0) { for(let g in inv) { html += `<div style=\"margin-bottom:20px; padding: 0; background: rgba(0,0,0,0.2); border-radius: 6px; border-left: 3px solid #8b5cf6; overflow: hidden;\"><div style=\"padding: 10px 15px; background: rgba(0,0,0,0.3); border-bottom: 1px solid rgba(255,255,255,0.05);\"><strong style=\"color:#f8fafc; font-size: 1.1em;\">Group: ${g}</strong></div>`; if (inv[g].hosts) { html += `<table style=\"width:100%; border-collapse: collapse;\"><tbody>`; for (let h in inv[g].hosts) { const flatten = (obj, prefix = \"\") => Object.keys(obj).reduce((acc, k) => { const pre = prefix.length ? prefix + \".\" : \"\"; if (typeof obj[k] === \"object\" && obj[k] !== null && !Array.isArray(obj[k])) Object.assign(acc, flatten(obj[k], pre + k)); else acc[pre + k] = obj[k]; return acc; }, {}); let flatObj = flatten(inv[g].hosts[h]||{}); let changed = true; let iterations = 0; while(changed && iterations < 5) {     changed = false;     for (let k in flatObj) {         if (typeof flatObj[k] === 'string' && flatObj[k].includes('{{')) {             let newVal = flatObj[k].replace(/\{\{\s*([\w.]+)\s*\}\}/g, function(match, p1) {                 return flatObj[p1] !== undefined ? flatObj[p1] : match;             });             if (newVal !== flatObj[k]) {                 flatObj[k] = newVal;                 changed = true;             }         }     }     iterations++; }  let missingHostVars = [...placeholders].filter(p => flatObj[p] === undefined && globalFlatVars[p] === undefined); for(let p of missingHostVars) { flatObj[p] = undefined; } let varsDisplay = ''; if (Object.keys(flatObj).length === 0) { varsDisplay = '<span style=\"color:#64748b; font-style:italic;\">No variables</span>'; } else { varsDisplay = '<table style=\"width:100%; border-collapse: collapse; font-size: 0.9em; margin: 5px 0; border: 1px solid rgba(255,255,255,0.05); border-radius: 4px; overflow: hidden;\"><tbody>'; for (let vk in flatObj) { let statusBadge = ''; let valStr = ''; if (flatObj[vk] === undefined) { statusBadge = '<span style=\"color:#ef4444; font-size:0.75rem; margin-left:8px; padding:2px 6px; background:rgba(239,68,68,0.15); border-radius:4px; font-weight:600;\">Missing</span>'; valStr = '<span style=\"color:#64748b; font-style:italic;\">undefined</span>'; } else { statusBadge = placeholders.has(vk) ? '<span style=\"color:#4ade80; font-size:0.75rem; margin-left:8px; padding:2px 6px; background:rgba(74,222,128,0.15); border-radius:4px; font-weight:600;\">Defined</span>' : '<span style=\"color:#facc15; font-size:0.75rem; margin-left:8px; padding:2px 6px; background:rgba(250,204,21,0.15); border-radius:4px; font-weight:600;\">Unused</span>'; valStr = typeof flatObj[vk] === 'string' ? flatObj[vk] : JSON.stringify(flatObj[vk]); } varsDisplay += `<tr style=\"border-bottom: 1px solid rgba(255,255,255,0.05); background: rgba(0,0,0,0.1);\"><td style=\"padding: 8px 12px; color: #10b981; vertical-align: top; width: 45%; border-right: 1px solid rgba(255,255,255,0.05);\">${vk} ${statusBadge}</td><td style=\"padding: 8px 12px; color: #cbd5e1; font-family: monospace;\">${valStr}</td></tr>`; } varsDisplay += '</tbody></table>'; } html += `<tr style=\"border-bottom: 1px solid rgba(255,255,255,0.05);\"><td style=\"padding: 10px 15px; color: #38bdf8; font-weight: 500; vertical-align: top; width: 30%; border-right: 1px solid rgba(255,255,255,0.05);\">${h}</td><td style=\"padding: 10px 15px; vertical-align: top;\">${varsDisplay}</td></tr>`; } html += `</tbody></table>`; } html += `</div>`; } } else { html += '<p style=\"color: #ef4444;\">Failed to parse or empty.</p>'; } } } else { html += '<p style=\"color: #94a3b8;\">No inventories found in the workspace.</p>'; } html += '</div>'; document.getElementById('logs-container').innerHTML = html; }); }); } function startRun(idx = 0) { document.getElementById('start-btn').disabled = true; document.getElementById('audit-btn').disabled = true; document.getElementById('lint-btn').disabled = true; document.getElementById('history-btn').disabled = true; document.getElementById('browse-btn').disabled = true; document.getElementById('arch-btn').disabled = true; document.getElementById('vars-btn').disabled = true; document.getElementById('inventories-btn').disabled = true; document.getElementById('logs-container').innerHTML = ''; const es = new EventSource('/api/run/' + idx + getInvQuery()); es.onmessage = (e) => { const data = JSON.parse(e.data); if(data.type === 'log') { appendLog(data.msg); } else if (data.type === 'system') { if(data.msg === 'Execution finished.' || data.msg.startsWith('Error:')) { es.close(); document.getElementById('start-btn').disabled = false; document.getElementById('audit-btn').disabled = false; document.getElementById('lint-btn').disabled = false; document.getElementById('history-btn').disabled = false; document.getElementById('browse-btn').disabled = false; document.getElementById('arch-btn').disabled = false; document.getElementById('vars-btn').disabled = false; document.getElementById('inventories-btn').disabled = false; if (currentTaskHeader) { let lastSpan = currentTaskHeader.querySelector('span:last-child'); if (lastSpan && lastSpan.className === 'status-running') { lastSpan.className = 'status-ok'; lastSpan.innerText = data.msg.startsWith('Error') ? 'Error' : 'Done'; } } } appendLog(data.msg); } }; es.onerror = () => { es.close(); document.getElementById('start-btn').disabled = false; document.getElementById('audit-btn').disabled = false; document.getElementById('lint-btn').disabled = false; document.getElementById('history-btn').disabled = false; document.getElementById('browse-btn').disabled = false; document.getElementById('arch-btn').disabled = false; document.getElementById('vars-btn').disabled = false; document.getElementById('inventories-btn').disabled = false; appendLog('FAILED: Connection error.'); }; } function runAudit() { document.getElementById('logs-container').innerHTML = '<p style=\"color:#64748b; text-align:center; margin-top:100px;\">Running Audit...</p>'; fetch('/api/audit' + getInvQuery()).then(r => r.json()).then(data => { let html = '<h2 style=\"margin-top:0; border:none; font-size:2rem; font-weight:800; color:transparent; background:linear-gradient(to right, #a855f7, #ec4899); -webkit-background-clip:text;\">Security Audit Results</h2>';  html += '<div class=\"task-card\" style=\"padding: 25px;\"><h3 style=\"margin-top:0; color: #f8fafc;\">Dangerous Tasks</h3>'; if(data.dangerous && data.dangerous.length > 0) { data.dangerous.forEach(t => { html += '<div style=\"margin-bottom: 20px; border-left: 5px solid #ef4444; background: linear-gradient(145deg, rgba(30,41,59,0.9), rgba(15,23,42,0.9)); padding: 20px; border-radius: 0 8px 8px 0; box-shadow: 0 10px 25px rgba(0,0,0,0.3);\"><b style=\"font-size: 1.2rem; color: #f8fafc; display: block; margin-bottom: 12px;\">' + (t.name || 'Unnamed') + '</b><pre style=\"background: rgba(0,0,0,0.6); padding: 15px; border-radius: 8px; color: #facc15; font-family: \\'JetBrains Mono\\', monospace; font-size: 1.05rem; overflow-x: auto; border: 1px solid rgba(255,255,255,0.05); margin: 0;\">' + t.cmd + '</pre></div>'; }); } else { html += '<p style=\"color: #4ade80;\">✓ No dangerous tasks found.</p>'; } html += '</div>'; document.getElementById('logs-container').innerHTML = html; if(window.mermaid) { window.mermaid.run(); } }); } function runLint() { document.getElementById('logs-container').innerHTML = '<p style=\"color:#64748b; text-align:center; margin-top:100px;\">Running Linter...</p>'; fetch('/api/lint' + getInvQuery()).then(r => r.json()).then(data => { let html = '<h2 style=\"margin-top:0; border:none; font-size:2rem; font-weight:800; color:transparent; background:linear-gradient(to right, #ec4899, #f43f5e); -webkit-background-clip:text;\">Linter Results</h2><div class=\"task-card\" style=\"padding: 25px;\">'; if(data.warnings && data.warnings.length > 0) { data.warnings.forEach(w => { html += '<div style=\"margin-bottom: 15px; border-left: 4px solid #facc15; background: rgba(0,0,0,0.3); padding: 15px; color: #cbd5e1;\">' + w + '</div>'; }); } else { html += '<p style=\"color: #4ade80;\">✓ No linting issues found.</p>'; } html += '</div>'; document.getElementById('logs-container').innerHTML = html; }); } function viewHistory() { document.getElementById('logs-container').innerHTML = '<p style=\"color:#64748b; text-align:center; margin-top:100px;\">Loading History...</p>'; fetch('/api/history').then(r => r.json()).then(data => { let html = '<h2 style=\"margin-top:0; border:none; font-size:2rem; font-weight:800; color:transparent; background:linear-gradient(to right, #14b8a6, #06b6d4); -webkit-background-clip:text;\">Run History</h2><div class=\"task-card\" style=\"padding: 25px;\">'; if(data.history && data.history.length > 0) { data.history.forEach(line => { let parts = line.split('/'); let filename = parts[parts.length - 1]; html += `<div style=\"margin-bottom: 8px; font-family: monospace; font-size: 0.9rem; color: #94a3b8; padding: 10px; border: 1px solid rgba(255,255,255,0.05); background: rgba(0,0,0,0.2); border-radius: 6px; cursor: pointer; transition: all 0.2s;\" onmouseover=\"this.style.background='rgba(56,189,248,0.1)'; this.style.borderColor='rgba(56,189,248,0.3)'; this.style.color='#f8fafc';\" onmouseout=\"this.style.background='rgba(0,0,0,0.2)'; this.style.borderColor='rgba(255,255,255,0.05)'; this.style.color='#94a3b8';\" onclick=\"loadHistoricalRun('${filename}')\">` + line + '</div>'; }); } else { html += '<p style=\"color: #94a3b8;\">No logs found.</p>'; } html += '</div>'; document.getElementById('logs-container').innerHTML = html; }); } function loadHistoricalRun(filename) { document.getElementById('logs-container').innerHTML = '<p style=\"color:#64748b; text-align:center; margin-top:100px;\">Loading Run...</p>'; fetch('/api/history/log/' + filename).then(r => r.text()).then(text => { document.getElementById('logs-container').innerHTML = `<h2 style=\"margin-top:0; border:none; font-size:1.5rem; font-weight:800; color:#38bdf8; margin-bottom: 20px;\">Run: ${filename}</h2>`; currentTaskHeader = null; currentTaskBody = null; const lines = text.split('\\n'); lines.forEach(line => { if(line.trim() !== '') appendLog(line); }); if (currentTaskHeader) { let lastSpan = currentTaskHeader.querySelector('span:last-child'); if (lastSpan && lastSpan.className === 'status-running') { lastSpan.className = 'status-ok'; lastSpan.innerText = 'Done'; } } }); } function renderTask(t) { let details = ''; for(let k in t) { if(k !== 'name') { let val = typeof t[k] === 'object' ? JSON.stringify(t[k], null, 2) : t[k]; details += `<div style=\"margin-bottom:8px;\"><strong style=\"color:#38bdf8;\">${k}:</strong> <span style=\"color:#cbd5e1;\">${val}</span></div>`; } } return `<div class=\"task-card\" style=\"margin-bottom: 10px; margin-left: 15px;\"><div class=\"task-header\" style=\"background: rgba(15, 23, 42, 0.8); border-left: 3px solid #3b82f6;\" onclick=\"this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'none' ? 'block' : 'none'\"><span style=\"color:#f8fafc; font-size: 1.05rem;\">▶ ${t.name || 'Unnamed Task'}</span></div><div style=\"padding: 15px; background: rgba(0,0,0,0.5); display: none; border-top: 1px solid rgba(255,255,255,0.05); font-family: monospace; font-size:0.95rem; white-space: pre-wrap;\">${details}</div></div>`; } function renderPlay(play, idx) { let out = `<div style=\"margin-bottom: 25px; padding: 20px; background: rgba(30,41,59,0.3); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);\"><h3 style=\"color: #a855f7; margin-top: 0; cursor: pointer;\" onclick=\"this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'none' ? 'block' : 'none'\">▼ Play: ${play.name || 'Unnamed Play'}</h3><div style=\"display: block;\">`; for(let key in play) { if(key !== 'tasks' && key !== 'name') { let val = typeof play[key] === 'object' ? JSON.stringify(play[key], null, 2) : play[key]; out += `<div style=\"margin-bottom:10px; padding: 10px; background: rgba(0,0,0,0.2); border-radius: 6px;\"><strong style=\"color:#94a3b8;\">${key}</strong>: <span style=\"color:#cbd5e1; font-family: monospace;\">${val}</span></div>`; } } if(play.tasks && play.tasks.length > 0) { out += `<h4 style=\"color: #f8fafc; margin-top: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 5px;\">Tasks (${play.tasks.length})</h4>`; play.tasks.forEach(t => { out += renderTask(t); }); } out += `</div></div>`; return out; } function browsePlaybook() { document.getElementById('logs-container').innerHTML = '<p style=\"color:#64748b; text-align:center; margin-top:100px;\">Loading Playbook...</p>'; fetch('/api/info' + getInvQuery()).then(r => r.json()).then(data => { let html = '<h2 style=\"margin-top:0; border:none; font-size:2rem; font-weight:800; color:transparent; background:linear-gradient(to right, #38bdf8, #818cf8); -webkit-background-clip:text;\">Browsable Playbook</h2>'; if (data.tasks) { let plays = Array.isArray(data.tasks) ? data.tasks : [data.tasks]; plays.forEach((play, i) => { html += renderPlay(play, i); }); } else { html += '<p>Failed to parse playbook tasks.</p>'; } document.getElementById('logs-container').innerHTML = html; }); } </script></body></html>") }
